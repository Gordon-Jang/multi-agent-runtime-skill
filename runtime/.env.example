# Copy this file to .env and fill your own provider settings.
# 将本文件复制为 .env，然后填写你自己的模型服务配置。

# Required. Never commit .env.
# 必填。不要把 .env 提交到 GitHub。
OPENAI_API_KEY=

# Optional. Use this for OpenAI-compatible gateways/proxies.
# 可选。使用 OpenAI 兼容中转/代理时填写，通常以 /v1 结尾。
OPENAI_BASE_URL=https://api.openai.com/v1

# Replace with a model supported by your provider.
# 替换成你的服务商支持的模型。
AUTOGEN_MODEL=gpt-4o-mini

# Lower temperature is better for coding/review workflows.
# 编码/审查类任务建议低温度。
AUTOGEN_TEMPERATURE=0.2

# Optional. Set to 0 for gateway-specific models unknown to AutoGen pricing.
# 可选。中转模型不在 AutoGen 价格表时，设为 0 可关闭本地价格警告。
AUTOGEN_PRICE_PROMPT_1K=0
AUTOGEN_PRICE_COMPLETION_1K=0
